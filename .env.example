# TERRA UTSAV environment variables
# Copy to .env.local for local development and fill in real values there.
# Never commit real values. On Netlify, add these under Site configuration > Environment variables.

# Public site address, used for canonical URLs, the sitemap and social previews (no trailing slash).
# Optional on Netlify, which supplies the site's address; set it when you add your own domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase project (Project Settings > API). The publishable/anon key is safe in the browser;
# row level security decides what it can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Supabase secret (service role) key. SERVER ONLY. Used by the game API to record results.
# Never prefix with NEXT_PUBLIC_ and never paste it into client code.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Optional: show "Continue with Google" on the sign-in page (enable the Google provider in Supabase first).
NEXT_PUBLIC_AUTH_GOOGLE=false

# Optional: allow search engines on hosts other than Netlify or Vercel. On those two it is automatic:
# only the production deploy is indexable; previews send noindex.
ALLOW_INDEXING=false
